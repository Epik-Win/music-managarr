# Copy to .env next to docker-compose.yml. docker-compose.yml passes these
# into the musicai container; the ARL page also writes DEEZER_ARL back here.

# ── Plex ──────────────────────────────────────────────────────────────────────
# The server owner's token (Plex Web → any item → Get Info → View XML →
# X-Plex-Token). Plex Home users' tokens are derived from it.
PLEX_TOKEN=
PLEX_URL=http://192.168.1.10:32400
PLEX_SERVER_NAME=
PLEX_MUSIC_SECTIONS=Music

# ── Users ─────────────────────────────────────────────────────────────────────
# Which mapping entry is the admin: "discord_handle:plex_username", or one name.
DISCORD_TO_PLEX_MAPPING_ADMIN=

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_MAIN_CHANNEL=
DISCORD_ENABLED=true

# ── Downloads ─────────────────────────────────────────────────────────────────
# Deezer "arl" cookie for deemix; it can also be renewed through the ARL page.
DEEZER_ARL=
ARL_SERVER_SECRET=change-me
ARL_PUBLIC_URL=

# ── Lidarr ────────────────────────────────────────────────────────────────────
LIDARR_URL=http://192.168.1.10:8686
LIDARR_API_KEY=

# ── VPN (Mullvad) ─────────────────────────────────────────────────────────────
MULLVAD_ACCOUNT_NUMBER=
MULLVAD_RELAY_COUNTRY=
MULLVAD_RELAY_CITY=

# ── Local AI (OpenAI-compatible: LiteLLM, llama.cpp, vLLM, Ollama …) ─────────
LOCAL_AI_API_BASE=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=

# ── Metadata, discovery and identification (all optional) ─────────────────────
LAST_FM_API_KEY=
DISCOGS_TOKEN=
ACOUSTID_API_KEY=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=
# Genius API client access token (https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=
WHISPER_URL=
SEARXNG_URL=
